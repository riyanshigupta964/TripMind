# Groq (required by current existing agent implementation)
GROQ_API_KEY=your_groq_api_key_here
# Existing flight/airport tools
TAVILY_API_KEY=your_tavily_api_key_here
SERPAPI_API_KEY=your_serpapi_key_here
# Optional Supabase persistence. Create a `trips` table as documented in README.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Use only on trusted backend server, never expose to frontend
SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
